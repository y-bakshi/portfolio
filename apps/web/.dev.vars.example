# Local secrets for `wrangler dev`. Copy this file to .dev.vars (which git ignores) and change the value.
SESSION_SECRET=replace-me-with-a-long-random-string
HMAC_SECRET=replace-me-with-another-long-random-string

# For real answers; without a key the guide says it cannot answer. Use a key you can revoke.
# GEMINI_API_KEY=

# Local development only: open /admin on localhost without the Access login.
# ADMIN_DEV_BYPASS=true

# Local development only: skip the question limits on localhost (the spending cap stays on).
# LIMITS_DEV_BYPASS=true

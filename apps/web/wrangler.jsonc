{
  // the site is plain static files: Cloudflare serves the build folder and shows 404.html for any other address
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  // the site is served from its own domain only: no workers.dev address and no public preview addresses
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}

{
  // the site is plain static files, with a small API under /api: Cloudflare serves the build folder,
  // shows 404.html for any other address, and runs the Worker only for addresses under /api
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // the site is served from its own domain only: no workers.dev address and no public preview addresses
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SITE_ORIGIN": "https://yashbakshi.com",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"],
  },
  // The model-backed guide (docs/architecture/rag.md). Turn it on in this order:
  //   1. uncomment "ai" below (Workers AI: embeddings and the fallback chat model)
  //   2. set the secret:  wrangler secret put GEMINI_API_KEY
  //   3. create the index:  wrangler vectorize create guide-chunks --dimensions=768 --metric=cosine
  //      and uncomment "vectorize" below (without it, the notes are searched in D1, which is fine here)
  //   4. add "LLM_PROVIDER": "gemini" to vars (and optionally "GEMINI_MODEL", "RAG_MIN_SCORE")
  //   5. index the notes: see "Rebuilding the index" in docs/architecture/rag.md
  // "ai": { "binding": "AI" },
  // "vectorize": [{ "binding": "VECTORIZE", "index_name": "guide-chunks" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guide",
      // replace with the id from `wrangler d1 create guide` before the first deploy
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations",
    },
  ],
}
